  "findings": [
    "NaTune repository remove queues DownloadManager.removeDownload without a per-move acknowledgment.",
    "ProgressiveDownloader removes the original request-derived cache key, not necessarily the resolved source-prefixed key selected for export. Both downloader removal and listener purge must be scoped.",
    "NaTune onDownloadRemoved invokes broad all-source-key purging on download AND player caches; individual purge exceptions are swallowed.",
    "Media3 onTaskStopped logs finalException but still calls onRemoveTaskStopped for REMOVING/RESTARTING. The index-removal exception is caught and a main-thread removal update is sent with finalException=null.",
    "PRDownloader request-lifetime cancel counts its latch down before a final transport completion callback; latch release alone does not prove staging is gone."
  ],
  "required_move_checks": [
    "Actual original request and chosen rendition identity; owner prevents re-add/restart/other destructive writers.",
    "Required encrypted move claim and verified URI playback/index relationship before any original removal.",
    "Do not hold cache monitors while awaiting manager/listener work that needs those monitors.",
    "Observe settled original task/callback, then freshly inspect exact persistent index and exact unchanged selected cache scope; callback alone releases no byte reservation.",
    "Preserve unrelated raw/source-prefixed keys and player-cache entries; no broad original helper after one-key verification."
  ],
  "limitations": [
    "Public source/version review plus separately retained exact APK helper inspection; internal Media3 handler/task bytecode hooks are not yet bound or device-tested.",
    "No private data, media, app operation, removal, installation, model or device execution.",
    "A direct WritableDownloadIndex edit has not been adopted as a substitute for a supported owner lifecycle."
  ]
}
